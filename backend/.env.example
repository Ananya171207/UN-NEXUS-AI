# Copy to .env (never commit .env). Every value is optional.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Event sources
UN_NEWS_CACHE_SECONDS=300
GDELT_CACHE_SECONDS=900
GDELT_COOLDOWN_SECONDS=900
SOURCE_ERROR_COOLDOWN_SECONDS=120
EVENTS_CACHE_SECONDS=120
UN_NEWS_FETCH_LIMIT=50
GDELT_FETCH_LIMIT=75
UN_NEWS_WAIT_SECONDS=12
GDELT_WAIT_SECONDS=4

# World Bank / country metadata
WORLDBANK_TIMEOUT=5
WORLDBANK_RETRIES=2
WORLDBANK_PROFILE_DEADLINE=12
WORLDBANK_CACHE_SECONDS=86400
COUNTRIES_CACHE_SECONDS=604800
COUNTRIES_RETRY_SECONDS=300

# SDG signals: values older than this many years are flagged "outdated"
SDG_OUTDATED_YEARS=5

# ---------------------------------------------------------------------------
# AI layer (OPTIONAL). Leave # none | gemini | openai
LLM_PROVIDER=none
# Google AI Studio key (gemini) or OpenAI key (openai)
LLM_API_KEY=
# Empty = built-in default (gemini-2.5-flash / gpt-4o-mini). Set it if a model is retired.
LLM_MODEL=
# Seconds per call
LLM_TIMEOUT=20
# After a failed call the LLM is left alone for this long
LLM_COOLDOWN_SECONDS=120
# Hard cap on spend
LLM_MAX_CALLS_PER_HOUR=60
# Events per LLM call
AI_BATCH_SIZE=8
# Default: app/data/ai_cache.sqlite3 (created automatically)
# AI_CACHE_PATH=
# If set, POST /api/events/enrich needs the header X-Admin-Token
# ADMIN_TOKEN=
